noncomputable def evalPair (a : ℚ × ℚ) : ℝ := (a.1 : ℝ)+(a.2 : ℝ)*Real.sqrt 6697
def pairBox (a : ℚ × ℚ) : Box := add (point a.1) (mul (point a.2) zBox)
def tBox : Box := div (sub (point 82) zBox) (add (point 82) zBox)
def eps : ℚ := tBox.hi^3
def tailBox (i j : Fin 6) : Box :=
  ⟨(tailLo i j : ℚ)/(scale : ℚ), (tailHi i j : ℚ)/(scale : ℚ)⟩

theorem sqrt_mem : Contains zBox (Real.sqrt 6697) := by
  have hs : (Real.sqrt 6697)^2=(6697 : ℝ) := Real.sq_sqrt (by norm_num)
  have hp := Real.sqrt_nonneg (6697 : ℝ)
  have hlo : (0 : ℝ)≤zBox.lo := by norm_num [zBox]
  have hlosq : (zBox.lo : ℝ)^2 < 6697 := by norm_num [zBox]
  have hhi : (0 : ℝ)≤zBox.hi := by norm_num [zBox]
  have hhisq : (6697 : ℝ) < (zBox.hi : ℝ)^2 := by norm_num [zBox]
  exact ⟨by nlinarith, by nlinarith⟩

theorem pairBox_sound (a : ℚ × ℚ) : Contains (pairBox a) (evalPair a) :=
  add_sound (point_sound a.1) (mul_sound (point_sound a.2) sqrt_mem)

theorem p_rounding (i j : Fin 6) : widens (pairBox (pData i j)) (pBox i j) := by
  fin_cases i <;> fin_cases j <;>
    norm_num [widens, pairBox, add, mul, point, pData, qData, pBox, qBox, zBox,
      min_def, max_def, Matrix.cons_val_zero, Matrix.cons_val_succ, tailLo, tailHi, scale]

theorem q_rounding (i j : Fin 6) : widens (pairBox (qData i j)) (qBox i j) := by
  fin_cases i <;> fin_cases j <;>
    norm_num [widens, pairBox, add, mul, point, pData, qData, pBox, qBox, zBox,
      min_def, max_def, Matrix.cons_val_zero, Matrix.cons_val_succ, tailLo, tailHi, scale]

theorem tBox_positive : 0<(add (point 82) zBox).lo ∧ 0≤tBox.lo ∧ tBox.hi<1 := by
  norm_num [tBox, div, sub, add, neg, point, inv, mul, zBox, min_def, max_def]

theorem tBox_sound : Contains tBox ((82-Real.sqrt 6697)/(82+Real.sqrt 6697)) :=
  div_sound tBox_positive.1 (sub_sound (point_sound 82) sqrt_mem)
    (add_sound (point_sound 82) sqrt_mem)

theorem tail_rounding (i j : Fin 6) :
    widens (add (pBox i j) (mul ⟨0,eps⟩ (qBox i j))) (tailBox i j) := by
  fin_cases i <;> fin_cases j <;>
    norm_num [widens, tailBox, add, mul, pBox, qBox, eps, tBox, div, sub,
      neg, point, inv, zBox, min_def, max_def, Matrix.cons_val_zero, Matrix.cons_val_succ, tailLo, tailHi, scale]

/-- All numerical radical isolation and outward enclosures are kernel checked. -/
theorem tail_formula_bound (k : ℕ) (hk : 3≤k) (i j : Fin 6) :
    Contains (tailBox i j) (evalPair (pData i j)+
      ((82-Real.sqrt 6697)/(82+Real.sqrt 6697))^k*evalPair (qData i j)) := by
  have ht := tBox_sound
  have hlo : (0 : ℝ)≤tBox.lo := by exact_mod_cast tBox_positive.2.1
  have hhi : (tBox.hi : ℝ)<1 := by exact_mod_cast tBox_positive.2.2
  have hp : 0≤(82-Real.sqrt 6697)/(82+Real.sqrt 6697) := hlo.trans ht.1
  have he : Contains (⟨0,eps⟩ : Box) (((82-Real.sqrt 6697)/(82+Real.sqrt 6697))^k) := by
    constructor
    · simpa using (pow_nonneg hp k)
    · have h1 := pow_le_pow_of_le_one hp (ht.2.trans (le_of_lt hhi)) hk
      have h2 := pow_le_pow_left₀ hp ht.2 3
      simpa [eps] using h1.trans h2
  exact widen_sound (tail_rounding i j)
    (add_sound (widen_sound (p_rounding i j) (pairBox_sound _))
      (mul_sound he (widen_sound (q_rounding i j) (pairBox_sound _))))

